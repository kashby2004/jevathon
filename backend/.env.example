# Copy to backend/.env (or repo-root .env) and fill in. Never commit the real .env.
BROWSERBASE_API_KEY=

# GMI Cloud serves Claude for Stagehand act/observe/extract (AI-driven actions).
GMI_API_KEY=
# GMI's model ID for Claude Sonnet; check GMI's model catalog if this 404s.
GMI_MODEL=anthropic/claude-sonnet-4.5

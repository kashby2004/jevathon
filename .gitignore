# Project-level Security & Noise Exclusions
# Copied into new project roots by Claude on init.
# Machine-wide protection lives in ~/.claude/global.gitignore.

# Notebook & Cold Memory IDs
notebooks.json

# Data Privacy & Datasets
*.csv
*.jsonl
*.sqlite
*.db
*.sqlite3
*.dump
*.parquet
*.h5
*.pickle
*.pkl

# Secrets & Credentials
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*_rsa
*_dsa
*credentials*
secrets.*

# OS & Editor Noise
.DS_Store
Thumbs.db
.idea/
.vscode/
.cursor/
*.swp
*.suo
*.user
*.iml
.project
.classpath
.settings/
nbproject/private/

# Common Dependency Directories
__pycache__/
*.pyc
venv/
.venv/
node_modules/
dist/
build/
.next/

# Examples are documentation, not secrets
!.env.example

# Claude-internal (local only)
project-log.md
.claude/
settings.local.json

# Python tooling
.pytest_cache/
*.egg-info/

# Vercel CLI
.vercel/

# Generated script output
backend/output/

# Coding agent worktrees
backend/.agent-work/
